<header class="site-header">
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    role="navigation"
    aria-label="Primary navigation"
  >
    <div class="container">
      <a class="navbar-brand portfolio-brand" href="{{ '/' | relative_url }}">
        <span class="brand-monogram" aria-hidden="true">TZ</span>
        <span class="brand-copy">
          <strong>Tahmid Zaman Tahi</strong>
          <small>Wireless AI Researcher</small>
        </span>
      </a>

      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              Home
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for nav_page in sorted_pages %}
            {% if nav_page.nav and nav_page.autogen == null %}
              {% assign parent_link = nav_page.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {% if nav_page.permalink contains '://' %}
                  {% assign nav_url = nav_page.permalink %}
                {% else %}
                  {% assign nav_url = nav_page.url %}
                {% endif %}
                <a class="nav-link" href="{{ nav_url | relative_url }}">
                  {{ nav_page.title }}
                  {% if page.url contains nav_page.url %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <li class="nav-item nav-resume">
            <a
              class="nav-link"
              href="{{ '/assets/rendercv/rendercv_output/Tahmid_Zaman_Tahi_CV.pdf' | relative_url }}"
              aria-label="Download résumé PDF"
            >
              Résumé
              <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
            </a>
          </li>

          {% if site.search_enabled %}
            <li class="nav-item nav-utility">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
              </button>
            </li>
          {% endif %}

          {% if site.enable_darkmode %}
            <li class="toggle-container nav-utility">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
