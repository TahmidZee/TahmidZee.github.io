---
layout: default
---
{% comment %}Site-owned research portfolio landing page.{% endcomment %}
{% assign resume_url = '/assets/rendercv/rendercv_output/Tahmid_Zaman_Tahi_CV.pdf' | relative_url %}
{% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}

<main class="portfolio-home">
  <section class="portfolio-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="availability-pill">
        <span class="availability-dot" aria-hidden="true"></span>
        Open to PhD research scientist internships
      </div>

      <p class="hero-eyebrow">Wireless AI researcher · Signal processing · Connected systems</p>
      <h1 id="hero-title">
        I build wireless systems that
        <span>learn from the physical world.</span>
      </h1>
      <p class="hero-lede">
        I am a PhD researcher at Virginia Commonwealth University developing learning-enabled methods for wireless sensing, localization, and reliable
        connected systems.
      </p>

      <div class="hero-actions" aria-label="Primary links">
        <a class="portfolio-button portfolio-button-primary" href="{{ '/research/' | relative_url }}">
          Explore my research
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a class="portfolio-button portfolio-button-secondary" href="{{ resume_url }}">
          <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
          Download résumé
        </a>
      </div>

      <div class="hero-socials" aria-label="Professional profiles">
        <a href="mailto:{{ site.data.socials.email }}" aria-label="Email Tahmid">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        </a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" aria-label="Google Scholar">
          <i class="ai ai-google-scholar" aria-hidden="true"></i>
        </a>
        <a href="https://github.com/{{ site.data.socials.github_username }}" aria-label="GitHub">
          <i class="fa-brands fa-github" aria-hidden="true"></i>
        </a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" aria-label="LinkedIn">
          <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
        </a>
        <span>Richmond, Virginia</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="signal-orbit signal-orbit-one" aria-hidden="true"></div>
      <div class="signal-orbit signal-orbit-two" aria-hidden="true"></div>
      <div class="signal-node signal-node-one" aria-hidden="true"></div>
      <div class="signal-node signal-node-two" aria-hidden="true"></div>
      <div class="portrait-frame">
        <span class="portrait-index" aria-hidden="true">TZT / 01</span>
        <figure>
          {%
            include figure.liquid loading="eager" path=profile_image_path class="portfolio-portrait" sizes="(min-width: 992px)
            390px, (min-width: 576px) 360px, 86vw" alt="Portrait of Tahmid Zaman Tahi" width=501 height=499 cache_bust=true
          %}
        </figure>
        <div class="portrait-caption">
          <span>
            <i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>
          </span>
          <p><strong>Current focus</strong> Learning-enabled RIS localization</p>
        </div>
      </div>
    </div>
  </section>

  <div class="focus-rail" aria-label="Research focus">
    <span class="focus-label">Research focus</span>
    <span>Wireless sensing</span>
    <i class="fa-solid fa-circle" aria-hidden="true"></i>
    <span>Signal-aware ML</span>
    <i class="fa-solid fa-circle" aria-hidden="true"></i>
    <span>Trustworthy V2X</span>
    <i class="fa-solid fa-circle" aria-hidden="true"></i>
    <span>Near-field localization</span>
  </div>

  <section class="portfolio-section research-section" aria-labelledby="research-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">What I investigate</p>
        <h2 id="research-heading">Research at the intersection of <span>physics and intelligence.</span></h2>
      </div>
      <a class="section-link" href="{{ '/research/' | relative_url }}">
        Research overview
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </div>

    <div class="research-grid">
      {% for theme in site.data.portfolio.research_themes %}
        <a class="research-card" href="{{ theme.url | relative_url }}">
          <div class="research-card-top">
            <span class="research-number">{{ theme.number }}</span>
            <span class="icon-disc"><i class="{{ theme.icon }}" aria-hidden="true"></i></span>
          </div>
          <h3>{{ theme.title }}</h3>
          <p>{{ theme.description }}</p>
          <div class="tag-row" aria-label="Methods">
            {% for tag in theme.tags %}
              <span>{{ tag }}</span>
            {% endfor %}
          </div>
          <i class="card-arrow fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      {% endfor %}
    </div>
  </section>

  <section class="portfolio-section skills-section" aria-labelledby="skills-heading">
    <div class="skills-intro">
      <p class="section-kicker">Technical depth</p>
      <h2 id="skills-heading">A toolkit built for <span>end-to-end research.</span></h2>
      <p>
        From physical-layer modeling and network simulation to GPU experiments and reproducible evaluation, I work across the full research pipeline.
      </p>
    </div>

    <div class="skills-grid">
      {% for skill in site.data.portfolio.skills %}
        <article class="skill-cluster">
          <div class="skill-title">
            <span class="skill-icon"><i class="{{ skill.icon }}" aria-hidden="true"></i></span>
            <h3>{{ skill.title }}</h3>
          </div>
          <div class="skill-pills">
            {% for item in skill.featured %}
              <span>{{ item }}</span>
            {% endfor %}
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="additional-tools">
      <span class="additional-label">
        <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
        Additional tools
      </span>
      {% for tool in site.data.portfolio.additional_tools %}
        <span>{{ tool }}</span>
      {% endfor %}
    </div>
  </section>

  <section class="portfolio-section work-section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Selected work</p>
        <h2 id="work-heading">Research ideas, built into <span>working systems.</span></h2>
      </div>
      <a class="section-link" href="{{ '/projects/' | relative_url }}">
        View all projects
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <div class="project-showcase">
      {% for project in site.data.portfolio.featured_projects %}
        <a class="showcase-card showcase-{{ project.accent }}" href="{{ project.url | relative_url }}">
          <div class="project-visual" aria-hidden="true">
            <span class="project-grid-lines"></span>
            <i class="{{ project.icon }}"></i>
            <span class="project-pulse project-pulse-one"></span>
            <span class="project-pulse project-pulse-two"></span>
          </div>
          <div class="project-copy">
            <p class="project-eyebrow">{{ project.eyebrow }}</p>
            <h3>{{ project.title }}</h3>
            <p>{{ project.description }}</p>
            <div class="tag-row">
              {% for tag in project.tags %}
                <span>{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
          <span class="project-link-icon"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
        </a>
      {% endfor %}
    </div>
  </section>

  <section class="portfolio-section publication-section" aria-labelledby="publications-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Selected publications</p>
        <h2 id="publications-heading">Research made <span>public.</span></h2>
      </div>
      <a class="section-link" href="{{ '/publications/' | relative_url }}">
        Full publication record
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    <div class="portfolio-publications">{% include selected_papers.liquid %}</div>
  </section>

  <section class="portfolio-section trajectory-section" aria-labelledby="trajectory-heading">
    <div class="trajectory-main">
      <div class="section-heading compact-heading">
        <div>
          <p class="section-kicker">Trajectory</p>
          <h2 id="trajectory-heading">Research, engineering, <span>and teaching.</span></h2>
        </div>
      </div>

      <div class="timeline">
        {% for item in site.data.portfolio.timeline %}
          <article class="timeline-item">
            <time>{{ item.date }}</time>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div>
              <h3>{{ item.role }}</h3>
              <p class="timeline-org">{{ item.organization }}</p>
              <p>{{ item.description }}</p>
            </div>
          </article>
        {% endfor %}
      </div>

      <a class="text-link" href="{{ resume_url }}">
        Download the complete résumé
        <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
      </a>
    </div>

    <aside class="news-panel" aria-labelledby="news-heading">
      <div class="news-panel-heading">
        <span class="live-dot" aria-hidden="true"></span>
        <h2 id="news-heading">Latest signals</h2>
      </div>
      {% assign news_items = site.news | sort: 'date' | reverse %}
      <div class="signal-list">
        {% for item in news_items limit: 3 %}
          {% if item.inline %}
            <div class="signal-item">
          {% else %}
            <a class="signal-item" href="{{ item.url | relative_url }}">
          {% endif %}
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
          <p>
            {% if item.inline %}
              {{ item.content | strip_html | truncatewords: 18 }}
            {% elsif item.title %}
              {{ item.title }}
            {% else %}
              {{ item.content | strip_html | truncatewords: 18 }}
            {% endif %}
          </p>
          {% unless item.inline %}
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          {% endunless %}
          {% if item.inline %}
            </div>
          {% else %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      <a class="text-link" href="{{ '/news/' | relative_url }}">
        All updates
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </aside>
  </section>

  <section class="portfolio-section writing-section" aria-labelledby="writing-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Notes & life beyond the lab</p>
        <h2 id="writing-heading">Ideas, process, <span>and perspective.</span></h2>
      </div>
      <a class="section-link" href="{{ '/writing/' | relative_url }}">
        Browse writing
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <div class="writing-grid">
      {% for post in site.posts limit: 2 %}
        <a class="writing-card" href="{{ post.url | relative_url }}">
          <div>
            <p class="writing-meta">
              {{ post.date | date: '%B %Y' }}
              <span aria-hidden="true">·</span>
              {{ post.categories | first | replace: '-', ' ' }}
            </p>
            <h3>{{ post.title }}</h3>
            <p>{{ post.description }}</p>
          </div>
          <span class="writing-arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </a>
      {% endfor %}
    </div>
  </section>

  <section class="portfolio-cta" aria-labelledby="contact-heading">
    <div>
      <p class="section-kicker">Let’s build what comes next</p>
      <h2 id="contact-heading">Working on wireless AI, sensing, or connected systems?</h2>
      <p>I’m always glad to discuss research collaborations and PhD internship opportunities.</p>
    </div>
    <a class="portfolio-button portfolio-button-light" href="mailto:{{ site.data.socials.email }}">
      Start a conversation
      <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
    </a>
  </section>
</main>
