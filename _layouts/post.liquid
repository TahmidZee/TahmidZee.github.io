---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      <time datetime="{% if page.display_date_iso %}{{ page.display_date_iso }}{% else %}{{ page.date | date_to_xmlschema }}{% endif %}">
        {% if page.display_date %}{{ page.display_date }}{% else %}{{ page.date | date: '%B %-d, %Y' }}{% endif %}
      </time>
      {% if page.last_modified_at %} · Updated {{ page.last_modified_at | date: '%B %-d, %Y' }}{% endif %}
    </p>
  </header>
  <article class="post-content">{{ content }}</article>
  <p class="article-back-link">
    {% if page.collection == 'news' -%}
      <a href="{{ '/news/' | relative_url }}">All news &amp; updates</a>
    {%- else -%}
      <a href="{{ '/notes/' | relative_url }}">All Field Notes</a>
    {%- endif %}
  </p>
</div>
